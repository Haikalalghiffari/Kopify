generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  KASIR
  ANGGOTA
}

enum MemberStatus {
  AKTIF
  NONAKTIF
}

enum StockMovementType {
  IMPORT
  PURCHASE
  SALE
  ORDER_FULFILLED
  ADJUSTMENT
  RETURN
}

enum OrderStatus {
  DIAJUKAN
  DIKONFIRMASI
  DISIAPKAN
  SIAP_DIAMBIL
  SELESAI
  DIBATALKAN
  DITOLAK
}

enum PaymentMethod {
  TUNAI
  TRANSFER
  DICATAT
  BON
}

enum PaymentStatus {
  LUNAS
  BELUM_LUNAS
}

enum SaleStatus {
  AKTIF
  BATAL
}

enum ImportType {
  ANGGOTA
  BARANG
  TRANSAKSI
}

enum ImportStatus {
  SUKSES
  GAGAL
  PARSIAL
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(ANGGOTA)
  isActive     Boolean  @default(true) @map("is_active")
  memberId     String?  @unique @map("member_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  member          Member?         @relation(fields: [memberId], references: [id])
  orders          Order[]         @relation("OrderCreatedBy")
  sales           Sale[]          @relation("SaleCreatedBy")
  stockMovements  StockMovement[]
  auditLogs       AuditLog[]
  importLogs      ImportLog[]
  importTemplates ImportTemplate[]

  @@map("users")
}

model Member {
  id        String       @id @default(cuid())
  memberNo  String       @unique @map("member_no")
  name      String
  nik       String?
  address   String?
  phone     String?
  email     String?
  joinedAt  DateTime     @default(now()) @map("joined_at")
  status    MemberStatus @default(AKTIF)
  deletedAt DateTime?    @map("deleted_at")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  user   User?
  orders Order[]
  sales  Sale[]

  @@map("members")
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")

  products Product[]

  @@map("categories")
}

model Unit {
  id        String    @id @default(cuid())
  name      String    @unique
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")

  products Product[]

  @@map("units")
}

model Supplier {
  id        String    @id @default(cuid())
  name      String
  phone     String?
  address   String?
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("suppliers")
}

model Product {
  id            String    @id @default(cuid())
  sku           String    @unique
  name          String
  categoryId    String    @map("category_id")
  unitId        String    @map("unit_id")
  costPrice     Int       @map("cost_price")
  sellPrice     Int       @map("sell_price")
  stock         Int       @default(0)
  reservedStock Int       @default(0) @map("reserved_stock")
  minStock      Int       @default(0) @map("min_stock")
  isActive      Boolean   @default(true) @map("is_active")
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  category       Category        @relation(fields: [categoryId], references: [id])
  unit           Unit            @relation(fields: [unitId], references: [id])
  stockMovements StockMovement[]
  orderItems     OrderItem[]
  saleItems      SaleItem[]

  @@map("products")
}

model StockMovement {
  id          String            @id @default(cuid())
  productId   String            @map("product_id")
  type        StockMovementType
  qtyChange   Int               @map("qty_change")
  stockBefore Int               @map("stock_before")
  stockAfter  Int               @map("stock_after")
  refType     String?           @map("ref_type")
  refId       String?           @map("ref_id")
  note        String?
  createdById String            @map("created_by")
  createdAt   DateTime          @default(now()) @map("created_at")

  product   Product @relation(fields: [productId], references: [id])
  createdBy User    @relation(fields: [createdById], references: [id])

  @@index([productId, createdAt])
  @@map("stock_movements")
}

model Order {
  id           String      @id @default(cuid())
  orderNo      String      @unique @map("order_no")
  memberId     String      @map("member_id")
  status       OrderStatus @default(DIAJUKAN)
  note         String?
  rejectReason String?     @map("reject_reason")
  total        Int         @default(0)
  createdById  String      @map("created_by")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  member    Member      @relation(fields: [memberId], references: [id])
  createdBy User        @relation("OrderCreatedBy", fields: [createdById], references: [id])
  items     OrderItem[]
  sale      Sale?

  @@index([memberId, status])
  @@map("orders")
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String @map("order_id")
  productId String @map("product_id")
  qty       Int
  unitPrice Int    @map("unit_price")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Sale {
  id            String        @id @default(cuid())
  saleNo        String        @unique @map("sale_no")
  orderId       String?       @unique @map("order_id")
  memberId      String?       @map("member_id")
  total         Int
  discount      Int           @default(0)
  paymentMethod PaymentMethod @map("payment_method")
  paymentStatus PaymentStatus @default(LUNAS) @map("payment_status")
  status        SaleStatus    @default(AKTIF)
  soldAt        DateTime      @default(now()) @map("sold_at")
  createdById   String        @map("created_by")
  createdAt     DateTime      @default(now()) @map("created_at")

  order     Order?     @relation(fields: [orderId], references: [id])
  member    Member?    @relation(fields: [memberId], references: [id])
  createdBy User       @relation("SaleCreatedBy", fields: [createdById], references: [id])
  items     SaleItem[]

  @@index([soldAt])
  @@map("sales")
}

model SaleItem {
  id        String @id @default(cuid())
  saleId    String @map("sale_id")
  productId String @map("product_id")
  qty       Int
  unitPrice Int    @map("unit_price")
  costPrice Int    @map("cost_price")

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@map("sale_items")
}

model ImportLog {
  id          String       @id @default(cuid())
  type        ImportType
  filename    String
  totalRows   Int          @map("total_rows")
  successRows Int          @map("success_rows")
  failedRows  Int          @map("failed_rows")
  status      ImportStatus
  mappingJson Json?        @map("mapping_json")
  createdById String       @map("created_by")
  createdAt   DateTime     @default(now()) @map("created_at")

  createdBy User @relation(fields: [createdById], references: [id])

  @@map("import_logs")
}

model ImportTemplate {
  id          String     @id @default(cuid())
  type        ImportType
  name        String
  mappingJson Json       @map("mapping_json")
  createdById String     @map("created_by")
  createdAt   DateTime   @default(now()) @map("created_at")

  createdBy User @relation(fields: [createdById], references: [id])

  @@map("import_templates")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  action     String
  entity     String
  entityId   String?  @map("entity_id")
  detailJson Json?    @map("detail_json")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([userId])
  @@index([entity, action])
  @@map("audit_logs")
}
