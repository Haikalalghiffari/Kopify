# ==============================================
# ENVIRONMENT VARIABLES - SISTEM INFORMASI KOPERASI
# ==============================================
# Salin file ini menjadi .env lalu sesuaikan nilai variabel.
# JANGAN PERNAH commit file .env asli ke repositori!

NODE_ENV=development
PORT=3000

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://koperasi_user:koperasi_pass@localhost:5433/koperasi_db?schema=public"
TEST_DATABASE_URL="postgresql://koperasi_user:koperasi_pass@localhost:5433/koperasi_test_db?schema=public"

# Auth.js / NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
# Buat string rahasia kuat, contoh via: openssl rand -base64 32
NEXTAUTH_SECRET="ganti_dengan_secret_acak_minimal_32_karakter_koperasi_dev"

# Initial Seed Credentials (Hanya dipakai saat seeding database dev)
ADMIN_INITIAL_USERNAME="admin"
ADMIN_INITIAL_EMAIL="admin@koperasi.local"
ADMIN_INITIAL_PASSWORD="AdminKoperasi2026!"
ADMIN_INITIAL_NAME="Administrator Koperasi"
